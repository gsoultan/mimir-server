# /etc/mimir-server/mimir-server.env: settings for the mimir-server
# console and its backup. Owned by root, mode 0640, group mimir-server.
# Every flag that has an environment variable can be set here;
# `mimir-server -h` lists them. Upgrades keep your changes to this file.

# Where the console listens. The default, 0.0.0.0:8080, is every
# interface, so a tunnel (such as cloudflared) or proxy on another machine
# reaches it; first-run setup needs the one-time token from the log, and
# everything after it a sign-in. It is plain HTTP, so keep the port to
# your network and reach it from outside through the tunnel or proxy, and
# set MIMIR_METRICS_TOKEN so /metrics isn't open. With the proxy on this
# machine only, keep the console to it:
#MIMIR_ADDR=127.0.0.1:8080

# The reverse proxy on this machine, so the console believes the client
# address and https it forwards.
MIMIR_TRUSTED_PROXIES=127.0.0.1,::1

# Require a token to read /metrics (or leave it to the proxy to block it).
#MIMIR_METRICS_TOKEN=

# Choose the first-run setup token yourself instead of reading it from the
# log (at least 16 characters). Remove it once setup is done.
#MIMIR_SETUP_TOKEN=

# Keep the secret key out of the data folder (and so out of its disk
# snapshots). The file must exist before first start; see docs/deploy.md.
#MIMIR_SECRET_KEY_FILE=/etc/mimir-server/secret.key

# With workers connected, leave every training run to them so training
# never shares this machine with the API; see docs/deploy.md step 6.
#MIMIR_TRAIN_HERE=false

# Owners can check for and install new versions from the About page, by
# hand or automatically; false turns that off, so upgrades come only from
# your package manager. See docs/deploy.md, Upgrades.
#MIMIR_UPDATES=false

# The most memory the console lets itself use, such as 6GiB or 75%; near
# it, it sheds loaded models and training rather than run out. Default:
# 85% of the service's MemoryMax, else of the machine. See docs/capacity.md.
#MIMIR_MEMORY_LIMIT=

# Tuning; see docs/deploy.md for what one server handles.
#MIMIR_TRAINING_JOBS=2
#MIMIR_MODEL_CACHE_MB=2048
#MIMIR_PREDICT_TIMEOUT=30s
