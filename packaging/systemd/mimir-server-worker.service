# A mimir-server worker: runs and teaches models for a console on another
# machine. Installing the package doesn't start it. Put the console's
# address and the token from Settings → Workers in
# /etc/mimir-server/worker.env, then:
#
#   systemctl enable --now mimir-server-worker
#
# Run either this or mimir-server.service on a machine, not both: a
# standalone console already has a worker in it. See docs/deploy.md.

[Unit]
Description=mimir-server worker
Documentation=https://github.com/gsoultan/mimir-server/blob/main/docs/deploy.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=mimir-server
Group=mimir-server
EnvironmentFile=/etc/mimir-server/worker.env
ExecStart=/usr/bin/mimir-server -role worker -server ${MIMIR_CONSOLE} -data /var/lib/mimir-server-worker

# The worker's key (which the console knows it by) and its model cache.
StateDirectory=mimir-server-worker
StateDirectoryMode=0700
UMask=0077

# A worker that loses its console keeps trying; one that stops lets the
# console put its runs back in the queue.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5s
LimitNOFILE=65536

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
# CUDA and ROCm need their device files: on a GPU machine set
# PrivateDevices=no with `systemctl edit mimir-server-worker`.
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
