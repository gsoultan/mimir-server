# Backs up the console's databases and data folder into
# /var/backups/mimir-server and keeps the newest 14.
# mimir-server-backup.timer runs it nightly once enabled:
#
#   systemctl enable --now mimir-server-backup.timer
#
# Run it by hand with `systemctl start mimir-server-backup`. Needs pg_dump
# (the PostgreSQL client tools, the database's major version or newer).
# The secret key is never in a backup. Keep a copy of it somewhere else.

[Unit]
Description=mimir-server backup
Documentation=https://github.com/gsoultan/mimir-server/blob/main/docs/deploy.md
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=mimir-server
Group=mimir-server
EnvironmentFile=-/etc/mimir-server/mimir-server.env
ExecStart=/usr/bin/mimir-server backup -data /var/lib/mimir-server -out /var/backups/mimir-server -keep 14
UMask=0077
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/mimir-server
ReadWritePaths=/var/backups/mimir-server
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
