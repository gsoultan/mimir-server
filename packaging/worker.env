# /etc/mimir-server/worker.env: settings for a mimir-server worker
# (mimir-server-worker.service). Owned by root, mode 0600: the token lets
# a machine run models for the console. Fill in both, then
# `systemctl enable --now mimir-server-worker`.

# The console to join.
#MIMIR_CONSOLE=https://mimir.example.com

# The token made under Settings → Workers.
#MIMIR_WORKER_TOKEN=mimirw_...

# The work it takes: `train` takes training runs only, `serve` predictions
# only, and unset (or `all`) both. See "Keeping training off the machines
# that answer" in docs/deploy.md.
#MIMIR_WORKER_TASKS=train
